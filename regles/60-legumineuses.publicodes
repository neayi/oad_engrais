# Légumineuses : pois, féverole, soja, luzerne.
# Pois, féverole et soja partagent leurs stades par des ancres YAML.

# ---------- Pois protéagineux ----------

culture . pois:
  titre: Pois protéagineux
  id: pois
  synonymes: [pois, pois proteagineux, pois de printemps, pois d hiver]
  légumineuse: oui
  exigence phosphore: moyenne
  exigence potasse: moyenne
  sensibilité acidité: moyenne

culture . pois . semis: &legumineuse_semis
  titre: Avant semis – semis
  id: fond
  phase: fond
  mots-clés: [avant semis, fond, fumure de fond, semis, au semis, implantation, mars, avril, automne]

culture . pois . semis . phosphore:
  valeur: 1
  source: COMIFER
  description: "Exigence moyenne (COMIFER)."

culture . pois . semis . potasse: &legumineuse_k_moyenne
  valeur: 1
  source: COMIFER
  description: "Exigence moyenne (COMIFER)."

culture . pois . semis . chaulage: &legumineuse_chaulage
  valeur: niveau . chaulage
  explication: explication . chaulage
  description: "La nodulation est pénalisée en sol acide : viser un pH eau d'au moins 6."

culture . pois . semis . azote: &legumineuse_semis_n
  valeur: 0
  description: "Légumineuse : aucun apport d'azote. La fixation symbiotique couvre les besoins, et l'azote apporté réduit la nodulation."

culture . pois . végétation: &legumineuse_vegetation
  titre: En végétation
  id: veg
  phase: veg
  mots-clés: [vegetation, levee, floraison, mai, juin]

culture . pois . végétation . azote: &legumineuse_vegetation_n
  valeur: 0
  description: "Légumineuse : aucun apport d'azote."

culture . pois . végétation . manganèse: &legumineuse_vegetation_mn
  valeur: niveau . si sol calcaire
  description: "Manganèse foliaire si carence en sol calcaire."

culture . pois . végétation . phosphore: &legumineuse_vegetation_p
  valeur: 0
  source: Arvalis
  description: "Phosphore et potasse en végétation : sans effet sur la production des grandes cultures."

# ---------- Féverole ----------

culture . féverole:
  titre: Féverole
  id: feverole
  synonymes: [feverole, feveroles, feve, feves]
  légumineuse: oui
  exigence phosphore: moyenne (classe par défaut)
  exigence potasse: moyenne (classe par défaut)
  sensibilité acidité: moyenne

culture . féverole . semis: *legumineuse_semis

culture . féverole . semis . phosphore:
  valeur: 1
  source: COMIFER
  description: "Exigence moyenne (classe par défaut, culture non classée par le COMIFER) (COMIFER)."

culture . féverole . semis . potasse:
  valeur: 1
  source: COMIFER
  description: "Exigence moyenne (classe par défaut) (COMIFER)."

culture . féverole . semis . chaulage: *legumineuse_chaulage
culture . féverole . semis . azote: *legumineuse_semis_n

culture . féverole . végétation: *legumineuse_vegetation
culture . féverole . végétation . azote: *legumineuse_vegetation_n
culture . féverole . végétation . manganèse: *legumineuse_vegetation_mn
culture . féverole . végétation . phosphore: *legumineuse_vegetation_p

# ---------- Soja ----------

culture . soja:
  titre: Soja
  id: soja
  synonymes: [soja]
  légumineuse: oui
  exigence phosphore: faible
  exigence potasse: moyenne
  sensibilité acidité: moyenne

culture . soja . semis: *legumineuse_semis

culture . soja . semis . phosphore:
  valeur: 1
  source: COMIFER
  description: "Exigence faible (COMIFER)."

culture . soja . semis . potasse: *legumineuse_k_moyenne
culture . soja . semis . chaulage: *legumineuse_chaulage

culture . soja . semis . azote:
  valeur: 0
  description: "Légumineuse : aucun apport d'azote. La fixation symbiotique couvre les besoins, et l'azote apporté réduit la nodulation. Inoculer les semences en l'absence d'historique de soja."

culture . soja . végétation: *legumineuse_vegetation
culture . soja . végétation . azote: *legumineuse_vegetation_n
culture . soja . végétation . manganèse: *legumineuse_vegetation_mn
culture . soja . végétation . phosphore: *legumineuse_vegetation_p

# ---------- Luzerne ----------

culture . luzerne:
  titre: Luzerne
  id: luzerne
  synonymes: [luzerne, luzernes]
  légumineuse: oui
  exigence phosphore: forte
  exigence potasse: moyenne
  sensibilité acidité: très forte

culture . luzerne . implantation:
  titre: Avant implantation
  id: fond
  phase: fond
  mots-clés: [avant semis, implantation, semis, fond, fumure de fond, aout, printemps]

culture . luzerne . implantation . chaulage:
  # pH cible de 6,5 : à pH neutre, pas de redressement.
  valeur: niveau . chaulage
  explication: explication . chaulage
  source: Arvalis
  description: "Le pH eau doit dépasser 6 pour l'installation du rhizobium. Chauler idéalement l'année précédant l'implantation : la correction est progressive."

culture . luzerne . implantation . phosphore:
  valeur: 2
  source: COMIFER
  description: "Exigence forte (COMIFER)."

culture . luzerne . implantation . potasse:
  valeur: 1
  source: COMIFER
  description: "Exigence moyenne (COMIFER) ; les exportations par les coupes sont élevées."

culture . luzerne . implantation . soufre:
  valeur: 1
  description: "Besoins en soufre importants pour une légumineuse fourragère."

culture . luzerne . implantation . bore:
  valeur: niveau . si sol calcaire
  description: "Sensible au bore en sol sableux ou calcaire."

culture . luzerne . implantation . azote:
  valeur: 0
  description: "Légumineuse : pas d'azote."

culture . luzerne . en place:
  titre: Luzerne en place (sortie d'hiver, entre coupes)
  id: enplace
  phase: veg
  mots-clés: [sortie hiver, sortie d hiver, entre coupes, apres coupe, apres fauche, coupe, en place, entretien]

culture . luzerne . en place . potasse:
  valeur: 1
  description: "Entretien des exportations, fortes en potasse, sur luzerne en place."

culture . luzerne . en place . phosphore:
  valeur: 1
  description: "Entretien selon l'analyse de terre."

culture . luzerne . en place . soufre:
  valeur: niveau . si sol superficiel
  description: "Soufre utile en sol filtrant."

culture . luzerne . en place . bore:
  valeur: niveau . si sol calcaire
  description: "Bore si sol calcaire ou sableux."

culture . luzerne . en place . azote:
  valeur: 0
  description: "Légumineuse : pas d'azote."
